crash.*.log
*.tfvars
*.tfvars.json
!terraform.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Runtime & OS artifacts
.DS_Store
Thumbs.db
app/documents/
deck/backup/
*.log
*.tmp
